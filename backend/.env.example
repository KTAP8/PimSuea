# Copy to backend/.env and fill in your values:
#   cp .env.example .env

PORT=3000

# Supabase — required for real DB/auth (without these, the API starts with a mock client)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-anon-or-publishable-key
SUPABASE_SECRET_KEY=your-service-role-secret-key

# Cloudflare R2 — required for file uploads (design previews, print files, assets)
CLOUDFLARE_ACCOUNT_ID=your-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
# Public Development URL from R2 bucket Settings (pub-*.r2.dev) — NOT *.r2.cloudflarestorage.com (S3 API, browsers cannot load it)
R2_PUBLIC_URL_PREVIEWS=https://pub-xxxxx.r2.dev
R2_PUBLIC_URL_PRINT=https://pub-xxxxx.r2.dev
R2_PUBLIC_URL_ASSETS=https://pub-xxxxx.r2.dev
R2_PUBLIC_URL_PRINT_ORDERED=https://pub-xxxxx.r2.dev

# Resend — optional locally; waitlist signup works without email, notify endpoint returns 503
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=PimSuea <hello@pimsuea.com>

# CORS — primary app origin (app subdomain); marketing site does not call the API directly
FRONTEND_URL=https://app.pimsuea.com

# Stripe — checkout (PromptPay + Thai cards). Use test keys until go-live.
# Dashboard → Developers → API keys
STRIPE_SECRET_KEY=sk_test_...
# Dashboard → Developers → Webhooks → endpoint signing secret (after /api/webhooks/stripe exists)
# Local dev: run `stripe listen --forward-to localhost:3000/api/webhooks/stripe` and paste whsec_ here
STRIPE_WEBHOOK_SECRET=whsec_...
# Unpaid checkout drafts auto-expire (hours). Default 24 if omitted.
STRIPE_PENDING_ORDER_TTL_HOURS=24

# Telegram — optional. Daily paid-order alerts at 12:00 Asia/Bangkok (not at payment time).
# One message per order paid in the last 24 hours that has not yet been notified.
# Also catches older paid orders that missed a previous send (capped per run).
# Manual catch-up: node scripts/telegram-notify-daily.js
# 1. @BotFather → /newbot → copy the token. If a token was ever pasted in a screenshot, /revoke and use the new one.
# 2. Open the bot and send it a message (it cannot message you first).
# 3. Chat id: open https://api.telegram.org/bot<TOKEN>/getUpdates
#    with NO slash between "bot" and the token. Read "chat":{"id": ...}.
#    If "result" is empty, message the bot again and reload.
# Missing either value: checkout still completes and no message is sent.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Redesign (guest studio + lifecycle emails) ───────────────────────────────
# Signs guest→account claim tokens (falls back to SUPABASE_SECRET_KEY if unset).
GUEST_CLAIM_SECRET=
# Lifecycle emails use RESEND_API_KEY / RESEND_FROM_EMAIL above; they are skipped until the key is set.
# Optional: separate secret for unsubscribe links (falls back to GUEST_CLAIM_SECRET / SUPABASE_SECRET_KEY).
EMAIL_UNSUBSCRIBE_SECRET=
# Optional: Google Business Profile review link used in the review-request email.
GOOGLE_REVIEW_URL=
# LINE ID shown in email footers.
LINE_ID=@PimSuea
