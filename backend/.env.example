# Copy to backend/.env and fill in your values:
#   cp .env.example .env

PORT=3000

# Supabase — required for real DB/auth (without these, the API starts with a mock client)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-anon-or-publishable-key
SUPABASE_SECRET_KEY=your-service-role-secret-key

# Cloudflare R2 — required for file uploads (design previews, print files, assets)
CLOUDFLARE_ACCOUNT_ID=your-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_PUBLIC_URL_PREVIEWS=https://pub-xxxxx.r2.dev
# Must be the R2 public dev domain for the design-previews bucket — NOT Supabase Storage S3 URL
R2_PUBLIC_URL_PRINT=https://your-print-public-url
R2_PUBLIC_URL_ASSETS=https://your-assets-public-url
R2_PUBLIC_URL_PRINT_ORDERED=https://your-ordered-print-public-url

# Resend — optional locally; waitlist signup works without email, notify endpoint returns 503
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=PimSuea <hello@pimsuea.com>

# CORS — primary app origin (app subdomain); marketing site does not call the API directly
FRONTEND_URL=https://app.pimsuea.com

# Stripe — checkout (PromptPay + Thai cards). Use test keys until go-live.
# Dashboard → Developers → API keys
STRIPE_SECRET_KEY=sk_test_...
# Dashboard → Developers → Webhooks → endpoint signing secret (after /api/webhooks/stripe exists)
# Local dev: run `stripe listen --forward-to localhost:3000/api/webhooks/stripe` and paste whsec_ here
STRIPE_WEBHOOK_SECRET=whsec_...
# Unpaid checkout drafts auto-expire (hours). Default 24 if omitted.
STRIPE_PENDING_ORDER_TTL_HOURS=24
