# Copy to pimsuea-frontend/.env and fill in your values:
#   cp .env.example .env

# Supabase — from Project Settings → API (anon / publishable key)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_DEFAULT_KEY=your-anon-or-publishable-key

# Backend API — defaults to http://localhost:3000/api if omitted
VITE_API_URL=http://localhost:3000/api

# Subdomain split — marketing (pimsuea.com) vs app (app.pimsuea.com)
# Local dev: localhost acts as the app; set VITE_FORCE_MARKETING=true to test marketing routes only
VITE_APP_URL=http://localhost:5173
VITE_MARKETING_URL=http://localhost:5173

# Google Fonts — optional; enables font picker in the design studio
VITE_PUBLIC_GOOGLE_FONTS_API_KEY=your-google-fonts-api-key

# Marketing — optional Gift-tier product ID for landing page CTA
VITE_GIFT_PRODUCT_ID=

# Stripe — publishable key only (Dashboard → Developers → API keys)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...

# PostHog product analytics (studio funnel + session replay)
# Disabled in local dev unless VITE_ANALYTICS_DEBUG=true
VITE_PUBLIC_POSTHOG_KEY=
VITE_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# VITE_ANALYTICS_DEBUG=true

# Checkout / order pages — legacy manual transfer (removed once Stripe is live)
# VITE_LINE_ID=@your-line-id
# VITE_LINE_QR_URL=https://example.com/line-qr.png
# VITE_PROMPTPAY_QR_URL=https://example.com/promptpay-qr.png
